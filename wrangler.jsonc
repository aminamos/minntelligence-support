{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "minntelligence-support",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-16",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "routes": [
    { "pattern": "support.minntelligence.fyi", "custom_domain": true }
  ],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "support-inbox-db",
      "database_id": "69c53477-4662-4e77-b421-830113d4013c",
      "migrations_dir": "./migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "FILES",
      "bucket_name": "support-inbox-files"
    }
  ],
  "send_email": [
    {
      "name": "EMAIL"
    }
  ]
}
